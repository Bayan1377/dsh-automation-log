{
  "name": "dsh-automation-log",
  "version": "0.1.0",
  "description": "Automations feed in the DSH left sidebar: recent schedule runs and local watcher events, click a row to open the chat it was delivered into",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "harness",
    "automation",
    "schedule",
    "watchers",
    "sidebar",
    "feed"
  ],
  "author": "bayan1377",
  "license": "MIT"
}
